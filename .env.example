# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://donation:donation@localhost:5432/donation_dev

# Redis
REDIS_URL=redis://localhost:6379

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_random_secret_here_min_32_chars

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# bKash Payment (Sandbox)
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_app_key
BKASH_APP_SECRET=your_app_secret
BKASH_USERNAME=your_username
BKASH_PASSWORD=your_password

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=donation-platform

# Sentry (optional)
SENTRY_DSN=your_sentry_dsn

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@example.com

# Logging
LOG_LEVEL=info

# Upstash Redis (Edge-compatible rate limiter for /api/auth/*)
# When unset, the limiter is a no-op (local dev + CI without creds still work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
