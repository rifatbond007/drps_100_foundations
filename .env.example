# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_URL=http://localhost:3000

# ─── Required on Vercel (Production + Preview) ────────────────────────────
# These MUST be set in Vercel → Project → Settings → Environment Variables
# for both Production and Preview environments, or the app will throw opaque
# 500s at module-load time. See docs/CI_CD_PIPELINE.md §10.3 for the full
# list and the rationale for each.
#
#   REDIS_URL         — Upstash/Redis Cloud URL. NOT localhost.
#   NEXTAUTH_URL      — Must match the deployment URL exactly.
#   NEXTAUTH_SECRET   — Random ≥32-char string.
#   AUTH_TRUST_HOST   — "true"
#   GOOGLE_CLIENT_ID  / GOOGLE_CLIENT_SECRET — from Google Cloud Console.
#   BKASH_RECEIVER_NUMBER — Personal bKash number (donors send here).
#   DATABASE_URL      — Neon connection string (already in the DB section
#                        below; flagged here so it's not missed).
# ──────────────────────────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://donation:donation@localhost:5432/donation_dev

# Redis
REDIS_URL=redis://localhost:6379

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_random_secret_here_min_32_chars

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# bKash Payment (Sandbox)
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_app_key
BKASH_APP_SECRET=your_app_secret
BKASH_USERNAME=your_username
BKASH_PASSWORD=your_password

# Personal bKash number the foundation receives donations on.
# Donors see this on /donate/submit. Must be set in BOTH:
#   - .env.local (this repo, gitignored)
#   - Vercel → Project Settings → Environment Variables (Production)
# The real value intentionally lives in .env.local, NOT here —
# .env.example is committed to source control and the personal
# receiving number should not appear in git history. The hardcoded
# fallback in src/lib/payment/index.ts is only for emergency dev use.
BKASH_RECEIVER_NUMBER=01XXXXXXXXX

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=donation-platform

# Sentry (optional)
SENTRY_DSN=your_sentry_dsn

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@example.com

# Logging
LOG_LEVEL=info

# Upstash Redis (Edge-compatible rate limiter for /api/auth/*)
# When unset, the limiter is a no-op (local dev + CI without creds still work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin email allowlist — comma-separated. Any user signing in with one of
# these emails is auto-promoted to ADMIN on sign-in (idempotent: safe to run
# on every login; bumps tokenVersion to invalidate cached JWTs).
# Defaults to the foundation email if unset.
ADMIN_EMAILS=drps19foundation.org@gmail.com

# ─── Vercel deployment (Production + Preview) ───────────────────────────
# NEXTAUTH_URL must match the deployment URL exactly (e.g.
# https://drps-100-foundations.vercel.app) so NextAuth v5 derives the
# correct session-cookie name + Secure flag. Without it the cookie is
# set without `Secure` and middleware.getToken() returns null on
# protected routes — login succeeds but /dashboard, /settings, /admin
# silently bounce back to the locale home with ?from=...
# NEXTAUTH_URL=https://drps-100-foundations.vercel.app

# AUTH_TRUST_HOST=true is the v5 way of telling NextAuth that the
# request URL it sees (post-proxy from Vercel) is trustworthy. The code
# also sets `trustHost: true` so this env var is belt-and-suspenders.
# AUTH_TRUST_HOST=true
